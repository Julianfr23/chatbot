# Twilio (consola > Account Info)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
# Número del sandbox (aparece en Messaging > Try it out > Send a WhatsApp message)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# (Opcional) tu WhatsApp personal, que ya hizo "join" al sandbox, para recibir cada pedido como si fueras Toño
TONO_WHATSAPP=whatsapp:+57XXXXXXXXXX

# Clave para ver /pedidos?key=...
ADMIN_KEY=pon-una-clave-larga

# LLM: gemini (gratis con API key de Google AI Studio) o anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=xxxxxxxx
GEMINI_MODEL=gemini-2.0-flash
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-5-5

# URL pública del servicio (Render o ngrok), sin / al final. Activa la validación de firma de Twilio.
PUBLIC_URL=https://tu-servicio.onrender.com
